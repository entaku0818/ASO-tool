# Server
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgres://aso:aso_password@localhost:5432/aso_tool?sslmode=disable

# JWT
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# App Store Connect encryption
# Generate a 32-byte hex key: openssl rand -hex 32
ASC_ENCRYPTION_KEY=

# Stripe (billing)
# Get these from https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Create products/prices at https://dashboard.stripe.com/products
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_YEARLY=price_

# Frontend base URL (used for Stripe redirect URLs)
FRONTEND_BASE_URL=http://localhost:3000
